    "https://www.spicychat.ai/*",
    "https://ts-lb.nd-api.com/*",
    "https://prod.nd-api.com/*",
    "https://cdn.nd-api.com/*",
    "https://cms.cdn.nd-api.com/*",
    "https://spicychat-archive-import.dragongraf.workers.dev/*",
    "https://syncqol.drache.uk/*",
    "https://data.spicychatarchive.drache.uk/*",
    "https://spicychatarchive.drache.uk/*"
  ],
  "background": {
    "service_worker": "background-entry.js"
  },
